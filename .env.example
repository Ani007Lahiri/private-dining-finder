# ─────────────────────────────────────────────────────────────────────────────
# Private Dining Finder — environment
#
# EVERY VARIABLE HERE IS OPTIONAL.
# With an empty .env.local the app boots and all three required scenarios work,
# served from the committed seed dataset through an in-memory repository.
# Each variable you add swaps one adapter from `seed` to `live`.
# Visit /api/health to see which adapters are currently active.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (PostgreSQL) ────────────────────────────────────────────────────
# Set both to move persistence from the in-memory repo to Postgres.
# Run supabase/migrations/0001_init.sql first, then `npm run seed:push`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-side only, never exposed to the browser.
# Required for the hydration worker to write venues/evidence discovered at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Maps Platform ─────────────────────────────────────────────────────
# Places API (New)  -> venue discovery + address autocomplete
# Routes API        -> stage-2 commute matrix (walking + driving)
# Without this, discovery is limited to the seed set and commute times are
# straight-line estimates labelled `likely` rather than measured `verified`.
GOOGLE_MAPS_API_KEY=

# Browser-exposed key for the address autocomplete widget. Restrict by HTTP
# referrer in the Google Cloud console. May be the same project, different key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── LLM extraction ───────────────────────────────────────────────────────────
# Used to pull per-space capacity and minimum spend out of venue event pages.
# Without this, no runtime extraction happens and newly discovered venues are
# surfaced with `unverified` capacity rather than fabricated numbers.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4-5

# ── Tuning ───────────────────────────────────────────────────────────────────
# How long a hydrated geographic cell stays fresh before re-enrichment.
HYDRATION_TTL_HOURS=168
# Max venue pages fetched + extracted per hydration job. Cost control.
HYDRATION_MAX_EXTRACTIONS=15
# Commute results cached against a geohash of the origin at this precision.
# 7 ≈ 150 m, so two searches from the same block reuse the same matrix.
COMMUTE_CACHE_GEOHASH_PRECISION=7

# ── Yelp reputation ──────────────────────────────────────────────────────────
# Fusion API key -> third-party rating, review count, and price tier ($-$$$$)
# attached to each venue. Yelp is an aggregator, so these are surfaced with a
# `likely` trust label and are never folded into the fit score -- they enable the
# "Highest Yelp rating" sort and a reputation line on each result. Without this,
# results carry no reputation signal and the app behaves exactly as before.
# Get a key at https://www.yelp.com/developers (free tier).
YELP_API_KEY=
